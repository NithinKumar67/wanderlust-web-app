<% layout('/layouts/basic.ejs') -%>

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <!-- Listing Card -->
            <div class="listing-show-card">

                <!-- Image -->
                <img 
                    src="<%= listing.image.url %>"
                    class="listing-show-img"
                    alt="<%= listing.title %>"
                >

                <!-- Details -->
                <div class="listing-show-content">

                    <div class="row">

                        <div class="col-lg-8">

                            <h1 class="listing-show-title">
                                <%= listing.title %>
                            </h1>

                            <p class="listing-location">
                                <i class="fa-solid fa-location-dot"></i>
                                <%= listing.location %>, <%= listing.country %>
                            </p>

                            <hr>

                            <h4>About this place</h4>

                            <p class="listing-show-description">
                                <%= listing.description %>
                            </p>

                            <i><h6>OwnedBy <%= listing.owner.username %></h6></i>

                        </div>

                        <!-- Price Card -->
                        <div class="col-lg-4">

                            <div class="price-card">

                                <h3>
                                    ₹<%= listing.price.toLocaleString("en-IN") %>
                                    <span>/ night</span>
                                </h3>

                                <p class="text-muted">
                                    Price per night
                                </p>

                                <hr>
                                <% if(curruser && curruser._id.equals(listing.owner._id)) {%>
                                <!-- Edit -->
                                <a 
                                    href="/listings/<%= listing._id %>/edit"
                                    class="btn btn-dark w-100 mb-2"
                                >
                                    <i class="fa-solid fa-pen-to-square"></i>
                                    Edit Listing
                                </a>

                                <!-- Delete -->
                                <form 
                                    action="/listings/<%= listing._id %>?_method=DELETE"
                                    method="POST"
                                >
                                    <button 
                                        type="submit"
                                        class="btn btn-outline-danger w-100"
                                    >
                                        <i class="fa-solid fa-trash"></i>
                                        Delete Listing
                                    </button>
                                </form>
                                <% } %>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<hr>

<div class="container mt-5 mb-5 ">
    <% if(curruser) { %>
    <h4>Leave a Review</h4>
    <form action="/listings/<%=listing.id%>/reviews" method="post" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating:</label>
            <fieldset class="starability-slot form-control">
                <input type="radio" id="no-rate" class="input-no-rate form-control" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Add Comment:</label>
            <textarea name="review[comment]" id="comment" cols="30" 
            rows="5" class="form-control" required ></textarea>
            <div class="invalid-feedback">Please leave a comment</div>
        </div>
        <button class="btn btn-dark px-4">Submit</button>

    </form>
    <hr>
    <% } %>
    <div class="row g-3">
    <%if (listing.reviews.length > 0) { %>
            <p><b>All Reviews</b></p>
        <% for(review of listing.reviews) { %>
            <div class="col-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@<%=review.author.username%></h5>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>">
                        Rated: 3 stars
                        </p>
                        <p class="card-text"><%= review.comment %></p>
                        <form class="mb-3" method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                    </div>
                    
                </div>
            </div>
        <% } %>
    <% } %>
    </div>
</div>
<div class="container mt-5 mb-5">
    <h1>Where you will be:</h1>

    <div
        id="map"
        data-token="<%= process.env.MAP_TOKEN %>"
        data-coordinates='<%- JSON.stringify(listing.geometry.coordinates) %>'
        data-location="<%= listing.location %>"
        data-country="<%= listing.country %>"
        data-title="<%= listing.title %>"
    ></div>
</div>

<script src="/js/map.js"></script>

